/.well-known/facebook-data-deletion /facebook-data-deletion.json 200!
/.well-known/* /.well-known/:splat 200!
/facebook-data-deletion.json /facebook-data-deletion.json 200!
# Policy pages app stores, Facebook and Twilio check
/privacy /privacy.html 200!
/privacy.html /privacy.html 200!
/terms /terms.html 200!
/terms.html /terms.html 200!
/pawpeer-account-deletion /pawpeer-account-deletion.html 200!
