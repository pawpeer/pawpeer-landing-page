# pawpeer.io has moved to pawpeer.co. Rules are checked top to bottom.

# Kept on pawpeer.io: Apple and Google verify app links per domain and don't
# follow redirects, and Facebook's data-deletion callback is machine-read.
/.well-known/facebook-data-deletion.json /facebook-data-deletion.json 200!
/.well-known/facebook-data-deletion /facebook-data-deletion.json 200!
/.well-known/* /.well-known/:splat 200!
/facebook-data-deletion.json /facebook-data-deletion.json 200!

# Pages with no match on pawpeer.co go to its home page.
/verify-email https://pawpeer.co/ 301!
/timeshare https://pawpeer.co/ 301!
/pawpeer_stayshare_host_value_sheet.html https://pawpeer.co/ 301!

# Everything else goes to the same path on pawpeer.co (query strings carry over).
/* https://pawpeer.co/:splat 301!
